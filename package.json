{
  "name": "real-estate-react-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "prettier --check src/App.tsx src/HomeExplorer.tsx src/PropertyMap.tsx src/Viewings.tsx src/portfolio.css server/*.mjs tests/*.mjs vite.config.ts tsconfig.portfolio.json",
    "preview": "vite preview",
    "dev:api": "node --experimental-sqlite server/index.mjs",
    "start": "node --experimental-sqlite server/index.mjs",
    "test:api": "node --experimental-sqlite --test tests/api.test.mjs",
    "test:ui": "npm run build && node tests/ui.mjs",
    "typecheck": "tsc -p tsconfig.portfolio.json",
    "format": "prettier --write src/App.tsx src/HomeExplorer.tsx src/PropertyMap.tsx src/Viewings.tsx src/portfolio.css server/*.mjs tests/*.mjs vite.config.ts tsconfig.portfolio.json",
    "test:vercel": "node tests/vercel-contract.mjs"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "lucide-react": "^0.378.0",
    "pg": "^8.23.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^7.18.5",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20.12.12",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "playwright": "^1.56.1",
    "prettier": "^3.10.1",
    "typescript": "^5.4.5",
    "vite": "^8.3.8"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
